# ============================================================
# TechnoBiz Trader AI — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# ─── AI — OpenRouter ─────────────────────────────────────────
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-YOUR_OPENROUTER_TOKEN
ANTHROPIC_MODEL=deepseek/deepseek-v4-flash:free

# ─── AI — Ollama (Local) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ─── Market Data ─────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
FINNHUB_API_KEY=your_finnhub_api_key
POLYGON_API_KEY=your_polygon_api_key
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_secret
TWELVEDATA_API_KEY=your_twelvedata_key

# ─── Email ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=technobiztrader@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=TechnoBiz Trader AI <technobiztrader@gmail.com>
DEFAULT_SIGNAL_EMAIL=technobiztrader@gmail.com

# ─── Database (optional) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/technobiz
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
